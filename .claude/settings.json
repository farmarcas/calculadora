{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(docker version *)",
      "Bash(docker info *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker build *)",
      "Bash(docker pull *)",
      "Bash(docker volume ls *)",
      "Bash(docker volume inspect *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(open -a Docker)",
      "Bash(scripts/validar-frontend.sh*)",
      "Bash(./scripts/validar-frontend.sh*)"
    ],
    "ask": [
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker kill *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker container *)",
      "Bash(docker network *)",
      "Bash(docker compose*rm*)"
    ],
    "deny": [
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker image prune*)",
      "Bash(docker container prune*)",
      "Bash(docker network prune*)",
      "Bash(docker compose*down*-v*)",
      "Bash(docker compose*down*--volumes*)",
      "Bash(docker-compose*down*-v*)",
      "Bash(docker-compose*down*--volumes*)",
      "Bash(docker compose*DROP DATABASE*)",
      "Bash(docker compose*DROP SCHEMA*)",
      "Bash(docker compose*DROP TABLE*)",
      "Bash(docker compose*drop database*)",
      "Bash(docker compose*drop schema*)",
      "Bash(docker compose*drop table*)",
      "Bash(docker compose*TRUNCATE*)",
      "Bash(docker compose*truncate*)",
      "Bash(docker compose*dropdb*)",
      "Bash(docker compose*migrate reset*)",
      "Bash(docker compose*--force-reset*)",
      "Bash(docker compose*db push*)"
    ]
  }
}
