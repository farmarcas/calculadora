# Copie para .env (cp .env.example .env). Nunca faça commit do .env.
# Valores abaixo servem só para ambiente local. As portas só aceitam conexões deste computador.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Portas no seu computador. Mude se alguma estiver ocupada.
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# Login pelo Radar. Desligado, a calculadora roda em modo demonstração, sem precisar do Radar.
SSO_HABILITADO=false
RADAR_AUTH_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Gere com: openssl rand -hex 32
JWT_SEGREDO=
# Endereço do Radar no botão "Ir para o Radar".
RADAR_URL=https://dev.radar.farmarcas.com.br
