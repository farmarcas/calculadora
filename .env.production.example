# Modelo das variáveis de PRODUÇÃO. Preencha no Coolify (aba de variáveis); não faça commit de valores reais.
# Para testar no seu computador: copie para um arquivo fora do repositório e use --env-file.

# Senha: use só letras e números (caracteres como @ : / # quebram a conexão com o banco). Gere uma forte e única.
POSTGRES_USER=calculadora
POSTGRES_PASSWORD=
POSTGRES_DB=calculadora

# O endereço público NÃO é variável: no Coolify, ligue o domínio ao serviço "web" (porta 80).

# Login pelo Radar: obrigatório em produção. Sem estas variáveis a publicação falha dizendo qual falta.
# Endereço da API de autenticação do Radar.
RADAR_AUTH_URL=https://authentication.api.radar.farmarcas.com.br
# Os mesmos valores cadastrados em Sso__Calculadora__ClientId e Sso__Calculadora__ClientSecret na API de autenticação.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Gere com: openssl rand -hex 32
JWT_SEGREDO=
# Endereço do Radar no botão "Ir para o Radar". Sem valor, vale o de produção.
RADAR_URL=https://radar.farmarcas.com.br
