# Copie para .env (cp .env.example .env). Nunca faça commit do .env.
# Valores abaixo servem só para ambiente local. As portas só aceitam conexões deste computador.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Portas no seu computador. Mude se alguma estiver ocupada.
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000

# Login pelo Radar. Desligado, a calculadora roda em modo demonstração, sem precisar do Radar.
SSO_HABILITADO=false
RADAR_AUTH_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Gere com: openssl rand -hex 32
JWT_SEGREDO=
# Endereço do Radar no botão "Ir para o Radar".
RADAR_URL=https://dev.radar.farmarcas.com.br

# Medição de uso (Mixpanel, projeto Radar Escala). Vazio = medição desligada. Token do projeto, nunca versionar o valor real.
MIXPANEL_TOKEN=
# Só se o projeto estiver na região da Europa (ex.: https://api-eu.mixpanel.com). Vazio = padrão.
MIXPANEL_API_HOST=
# Quantas sessões gravar para o mapa de calor e o replay do Mixpanel (0 a 100). Vazio = todas quando há token; 0 desliga a gravação.
MIXPANEL_REPLAY_PERCENT=
# Liga as feature flags e experimentos do Mixpanel (só para quem entrou pelo Radar). Vazio = ligado quando há token; 0 ou false desliga.
MIXPANEL_FLAGS=
