# Servidor da tela em produção. O nginx troca ${API_UPSTREAM} ao iniciar (padrão: http://api:4000).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Planilhas (cadastro, ponto) podem ser grandes.
  client_max_body_size 20m;

  # Endereço da API resolvido a cada chamada: se a API reiniciar, o nginx não cai.
  resolver 127.0.0.11 valid=10s ipv6=off;

  location /api/ {
    set $api ${API_UPSTREAM};
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 120s;
  }

  location /health {
    set $api ${API_UPSTREAM};
    proxy_pass $api;
  }

  # Arquivos com hash no nome nunca mudam: cache longo.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # O retorno do Radar traz o código no endereço: não vai para o log nem para outros sites.
  location = /sso/callback {
    access_log off;
    add_header Cache-Control "no-store";
    add_header Referrer-Policy "no-referrer";
    try_files /index.html =404;
  }

  # Qualquer outro caminho volta para a tela (rotas do React).
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
